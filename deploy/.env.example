# ThunderVox - host environment (template)
# ========================================
# Copy to .env in this directory; docker compose reads it automatically. .env is gitignored - it holds the real
# address and the passwords. Every value here is site-local; nothing in it is committed.

# ---- What runs ----

# Profiles `docker compose up` starts - by hand in this directory and from the system service (thundervox.service)
# alike. Empty = the bare core (core + rtpengine). provisioning = + postgres, server, web and the edge proxy.
# tls = + the edge proxy alone (a certificate for SIP over TLS without the console). Comma-separated.
COMPOSE_PROFILES=provisioning

# ---- Public names and TLS (edge proxy; profile "provisioning" or "tls") ----

# Every name must have an A record pointing at this host BEFORE the first start of the edge container: the
# certificate is issued over an HTTP challenge on port 80, and a name that does not resolve here fails it.

# Operator console (the web UI)
TVX_CONSOLE_HOST=console.example.com
# Provisioning API under its own name (mobile backend, integrations, OpenAPI document)
TVX_SERVER_HOST=server.example.com
# SIP service name. MUST equal TVX_SIP_DOMAIN in local.cfg - that is the name devices register to, and the
# name the certificate is issued for when TVX_TLS is on.
TVX_SIP_HOST=sip.example.com
# Address the CA sends expiry notices to; also the ACME account identity
TVX_ACME_EMAIL=admin@example.com

# Browser origins allowed to call the server API cross-site, comma-separated. Leave EMPTY for the standard
# deployment: the console reaches the API through its own nginx on its own name, which is same-origin and
# needs no CORS. Fill it only when a browser on another name calls the API directly - e.g.
# "https://console.example.com" when the console is built with VITE_API_BASE_URL, or the Swagger UI opened on
# TVX_SERVER_HOST. A wildcard is rejected by the server: the policy allows credentials.
TVX_CORS_ORIGINS=

# ---- Core and media (always) ----

# Server public IP. MUST equal TVX_PUBLIC_IP in local.cfg: kamailio advertises it in SIP, rtpengine binds media on it.
TVX_PUBLIC_IP=203.0.113.10
# Address of the local interface when it differs from the public one (1:1 NAT at the hoster). Empty on a plain VPS.
TVX_LOCAL_IP=
# rtpengine syslog level: 6 = info, 7 = debug
TVX_RTP_LOG_LEVEL=6

# ---- Provisioning layer (profile "provisioning") ----

# Password of the database superuser "thundervox" (schema owner; the server runs migrations as it)
TVX_DB_PASSWORD=
# Password of the database role "tvx_sip" the core authenticates with (created by the server's migration V3);
# the same value goes into TVX_DB_URL in local.cfg
TVX_SIP_DB_PASSWORD=
# Log level of the server's own packages
TVX_LOG_LEVEL=INFO
# Signing key of the console's login tokens, at least 32 characters (openssl rand -hex 32). Changing it logs
# everybody out.
TVX_JWT_SECRET=
# The super administrator of the console - the only account that manages administrators. The server creates or
# updates it from these two values on every start; the console cannot edit it. Password at least 12 characters.
# A changed password logs out the super administrator's open sessions.
TVX_SUPERADMIN_LOGIN=
TVX_SUPERADMIN_PASSWORD=
# How long a console login lasts (ISO-8601 duration). Optional, default 8 hours.
#TVX_CONSOLE_TOKEN_TTL=PT8H
# Token the SIP core presents to the server's internal API (X-CORE-TOKEN) when it asks for a wake push; at least
# 32 characters, hex (openssl rand -hex 32) because the same value goes into local.cfg as TVX_CORE_TOKEN, where
# '!' would break the line. Empty = the internal API is off and TVX_PUSH_WAIT cannot work. Tokens of the
# service API for the operator's backend are not here any more: the super administrator issues them on the
# console's Integration page.
TVX_CORE_TOKEN=
