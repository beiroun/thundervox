# ThunderVox - the compose stack of this directory as one system service
# ======================================================================
# Install (see RUNBOOK.md "System service"): the unit is rendered with the real path of this directory, the
# committed file carries the canonical /opt/thundervox/deploy.
#
#   systemctl start thundervox     config check of the core, then `docker compose up -d`
#   systemctl reload thundervox    the same on a running system - after `git pull`, `docker compose pull` or an
#                                  edit of .env / local.cfg; changed services are recreated, and the core is
#                                  recreated every time (see below)
#   systemctl stop thundervox      `docker compose down`: containers removed, the postgres-data volume and every
#                                  file in this directory stay
#
# Which services start is decided by COMPOSE_PROFILES in .env, not here - the unit and a manual `docker compose`
# in this directory always see the same set.
#
# Containers keep `restart: always`, so Docker revives a crashed one by itself; the unit owns start/stop of the
# whole set. `down` on stop is deliberate: a stopped-but-present container with `restart: always` would be
# started again by the Docker daemon on the next boot even with the unit disabled.

[Unit]
Description=ThunderVox (SIP core, media, provisioning layer, edge proxy)
Documentation=https://github.com/beiroun/thundervox/blob/release/deploy/RUNBOOK.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/thundervox/deploy
# A typo in local.cfg fails the start here instead of leaving the core in a restart loop. --no-deps: the check
# needs only the core image, not a running rtpengine.
ExecStartPre=/usr/bin/docker compose run --rm --no-deps core -c -f /etc/kamailio/kamailio.cfg
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose run --rm --no-deps core -c -f /etc/kamailio/kamailio.cfg
ExecReload=/usr/bin/docker compose up -d --remove-orphans
# Compose recreates a container only when its service definition or image changed; an edited bind-mounted
# local.cfg is neither, so without this line a switch flipped in local.cfg would never reach the running core.
# Kamailio reads its config at start only. With TVX_PROVISIONING the registrations survive the recreation (they
# are in PostgreSQL); without it devices re-REGISTER within their own interval.
ExecReload=/usr/bin/docker compose up -d --no-deps --force-recreate core
ExecStop=/usr/bin/docker compose down
# The first start on a fresh host may pull every image
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
