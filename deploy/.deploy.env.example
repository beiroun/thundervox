# SPDX-License-Identifier: BUSL-1.1
# Where deploy/push.sh sends the files. Copy to deploy/.deploy.env (gitignored): the real address and ssh port of
# the host stay out of this public repository.

# user@host of the server (key-based ssh login; the script never asks for a password twice - sftp and ssh)
TVX_DEPLOY_TARGET=root@host.thundervox.ru
# ssh port of the host
TVX_DEPLOY_PORT=2022
# the umbrella's deploy/ directory on the host - the checkout the system service was installed from
TVX_DEPLOY_DIR=/root/thundervox/deploy
