# SPDX-License-Identifier: BUSL-1.1
# Where deploy/push.sh sends the files and how it logs in. Copy to deploy/.deploy.env (gitignored): the real
# address, ssh port and key of the host stay out of this public repository. A variable exported in the shell
# overrides the file for one call.

# user@host of the server
TVX_DEPLOY_TARGET=root@sip.example.com
# ssh port of the host
TVX_DEPLOY_PORT=22
# the umbrella's deploy/ directory on the host - the checkout the system service was installed from
TVX_DEPLOY_DIR=/opt/thundervox/deploy

# Login. A key is the clean way - make one and put it on the host once:
#   ssh-keygen -t ed25519 -f ~/.ssh/thundervox -N ''
#   ssh-copy-id -i ~/.ssh/thundervox.pub -p 22 root@sip.example.com     (asks the password this one time)
# sftp runs in batch mode and cannot ask for a password, so without a key the ssh agent has to hold one that
# the host accepts.
TVX_DEPLOY_KEY=~/.ssh/thundervox
# Fallback instead of a key: a password, passed through sshpass (brew install hudochenkov/sshpass/sshpass).
# Leave empty when a key is used.
TVX_DEPLOY_PASSWORD=
