# ThunderVox - edge proxy: public names, TLS, HTTP->HTTPS
# =======================================================
# The only container that faces the internet on 80/443. Everything behind it listens on loopback, so this file
# is the single place where a public name is mapped to a service.
#
# Certificates: obtained and renewed automatically (ACME HTTP-01 on port 80) and stored in the mounted data
# directory. Nothing TLS-related is ever written into this repository - the private keys exist only on the host.
#
# Host names come from .env (parse-time substitution, which is what Caddy allows in a site address); this file
# stays site-agnostic and committed. A name must resolve to this host BEFORE the first start, otherwise the
# ACME challenge fails and Caddy retries with a backoff.

{
	# Expiry notices from the CA; also the ACME account identity
	email {$TVX_ACME_EMAIL}
}

# Shared hardening for the browser-facing names. HSTS is set by Caddy itself on an HTTPS site.
(hardening) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# Operator console: the SPA and, under /api, the server it proxies to - one origin, so the browser needs no CORS
{$TVX_CONSOLE_HOST} {
	import hardening
	header {
		# The console is never meant to be embedded anywhere
		X-Frame-Options DENY
	}
	reverse_proxy 127.0.0.1:8081
}

# Provisioning API under its own name: for the mobile backend, integrations and the OpenAPI document. A browser
# client arriving here from the console's origin is a cross-site call - allow it on the server (TVX_CORS_ORIGINS).
{$TVX_SERVER_HOST} {
	import hardening
	reverse_proxy 127.0.0.1:8080
}

# The SIP name is here for one reason: to hold a valid certificate for the core (TVX_TLS reads it from the
# shared data directory). SIP itself never speaks HTTP, so a browser that lands here is told where to go.
{$TVX_SIP_HOST} {
	import hardening
	respond "ThunderVox SIP endpoint. SIP signalling is on UDP/TCP 5060 and TLS 5061, not HTTP." 404
}
