# ThunderVox — deployment environment (template)
# ==============================================
# Copy to .env in this directory; docker compose reads it automatically.
# .env is gitignored — it holds the real host address.

# Server public IP. MUST equal TVX_PUBLIC_IP in configuration/local.cfg:
# kamailio advertises it in SIP, rtpengine binds media on it.
TVX_PUBLIC_IP=203.0.113.10
